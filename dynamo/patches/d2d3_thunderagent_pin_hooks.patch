+    def record_prompt_tokens(self, program_id: str, token_ids) -> None:
+        """Remember the latest prompt so a pause can pin it by content.
+
+        token_ids may be any int sequence (the Rust binding hands back
+        non-list sequences); coerce here, once, off the hot path's
+        critical structures.
+        """
+        if not self._pin_enabled:
+            return
+        try:
+            tokens = [int(t) for t in token_ids]
+        except TypeError:
+            if not getattr(self, "_record_type_warned", False):
+                self._record_type_warned = True
+                logger.warning(
+                    "record_prompt_tokens: unusable token_ids type %s",
+                    type(token_ids).__name__,
+                )
+            return
+        if not tokens:
+            return
+        self._prompt_tokens[program_id] = tokens
+        if not getattr(self, "_record_logged", False):
+            self._record_logged = True
+            logger.info(
+                "pin.record first prompt cached: program=%s n_tokens=%d src_type=%s",
+                program_id, len(tokens), type(token_ids).__name__,
+            )
+
+    def _fire_pin(self, program_id: str, unpin: bool) -> None:
+        if not self._pin_enabled:
+            return
+        tokens = None
+        if not unpin:
+            tokens = self._prompt_tokens.get(program_id)
+            logger.info(
+                "pin.fire program=%s cached=%s dict_size=%d",
+                program_id, tokens is not None, len(self._prompt_tokens),
+            )
+            if tokens is None:
+                return
+        try:
+            loop = asyncio.get_event_loop()
+            loop.run_in_executor(None, self._send_pin, program_id, tokens, unpin)
+        except Exception:
+            logger.exception("flexkv pin dispatch failed (non-fatal)")
 
+    def _send_pin(self, program_id: str, tokens, unpin: bool) -> None:
+        # Executor thread: blocking IPC is fine here. Broadcast to every
+        # FlexKV server on this node; non-owning servers simply match nothing.
+        try:
+            import glob as _glob
+
+            import zmq as _zmq
+
+            from flexkv.server.request import PinRequest, UnpinRequest
+
+            if self._pin_endpoints is None:
+                self._pin_endpoints = sorted({
+                    "ipc://" + p
+                    for p in _glob.glob("/tmp/flexkv_server*")
+                    if "gpu_register" not in p
+                })
+            if not self._pin_endpoints:
+                return
+            ctx = _zmq.Context(1)
+            try:
+                for endpoint in self._pin_endpoints:
+                    sock = ctx.socket(_zmq.PUSH)
+                    sock.setsockopt(_zmq.LINGER, 500)
+                    sock.connect(endpoint)
+                    if unpin:
+                        request = UnpinRequest(dp_client_id=-1, pin_id=program_id)
+                    else:
+                        request = PinRequest(
+                            dp_client_id=-1, token_ids=tokens, pin_id=program_id
+                        )
+                    sock.send_pyobj(request)
+                    sock.close()
+            finally:
+                ctx.term()
+            logger.info(
+                "pin.%s program=%s endpoints=%d tokens=%s",
+                "unpin" if unpin else "request",
+                program_id,
+                len(self._pin_endpoints),
+                "-" if tokens is None else len(tokens),
+            )
+        except Exception:
+            logger.exception("flexkv pin send failed (non-fatal)")
+
