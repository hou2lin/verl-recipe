+@dataclass
+class PinRequest:
+    """Pin the CPU radix path matching token_ids against eviction.
+
+    Victim/active-set pinning (ThunderAgent L2 design): sent by the TA router
+    so the write-behind CPU copy survives until it is read back.
+    Fire-and-forget (no response), like PutRequest.
+    """
+    dp_client_id: int
+    token_ids: "np.ndarray"
+    pin_id: str
+    task_id: int = -1
+    namespace: "Optional[List[str]]" = None
+
+
+@dataclass
+class UnpinRequest:
+    """Release a pin created by PinRequest. Idempotent."""
+    dp_client_id: int
+    pin_id: str
+    task_id: int = -1
